# iStoreOS 25.12 / Rockchip RK3568 / H69K H68K H66K 合并固件
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_hinlink_opc-h6xk=y
# H66K/H68K/H69K 合并内核与设备树需要比默认 16 MiB 更大的启动分区
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=1024

# Wi-Fi 6 / Wi-Fi 7 功能（RTL8922AE 依赖 11BE）
CONFIG_DRIVER_11AC_SUPPORT=y
CONFIG_DRIVER_11AX_SUPPORT=y
CONFIG_DRIVER_11BE_SUPPORT=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_libiwinfo=y

# Realtek RTL8852BE / RTL8922AE
CONFIG_PACKAGE_kmod-rtw89=y
CONFIG_PACKAGE_kmod-rtw89-pci=y
CONFIG_PACKAGE_kmod-rtw89-8852b-common=y
CONFIG_PACKAGE_kmod-rtw89-8852be=y
CONFIG_PACKAGE_rtl8852be-firmware=y
CONFIG_PACKAGE_kmod-rtw89-8922ae=y
CONFIG_PACKAGE_rtl8922ae-firmware=y

# MediaTek MT7916 (mt7915e 驱动和 MT7916 固件)
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7916-firmware=y

# Qualcomm QCNFA765 / WCN6855
CONFIG_PACKAGE_kmod-ath11k=y
CONFIG_PACKAGE_kmod-ath11k-pci=y
CONFIG_PACKAGE_ath11k-firmware-wcn6855=y

# QModem USB 数据模式：QMI / ECM / MBIM / NCM / RNDIS / 华为 NCM
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
# QModem AT 口：ttyUSB / ttyACM
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-qualcomm=y
CONFIG_PACKAGE_kmod-usb-acm=y
CONFIG_PACKAGE_kmod-usb-wdm=y
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_umbim=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_pciutils=y

# NAS / 存储
CONFIG_PACKAGE_kmod-nvme=y
CONFIG_PACKAGE_kmod-fs-ext4=y

# QModem 官方版后端 + 新 LuCI
CONFIG_PACKAGE_qmodem=y
CONFIG_PACKAGE_luci-app-qmodem-next=y
# 优先使用通用 QMI WWAN，避免不同厂商驱动互相冲突
CONFIG_PACKAGE_qmodem_INCLUDE_generic-qmi-wwan=y
# PCIe 5G MHI 未默认开启，后续按具体模组决定
# CONFIG_PACKAGE_qmodem_INCLUDE_ADD_PCI_SUPPORT is not set

# 避免 QModem 和 ModemManager 同时争用 AT 口
# CONFIG_PACKAGE_modemmanager is not set
# CONFIG_PACKAGE_luci-proto-modemmanager is not set
